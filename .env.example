# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server only. NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site
SITE_URL=https://your-real-domain.example

# Feature flags
FEATURE_MANUAL_PAYMENTS_ENABLED=false
ORDER_ALERT_EMAILS=rock-uc-foods@gmail.com,estherkwentua@gmail.com

# Security
CRON_SECRET=your_generated_cron_secret
DOCUMENT_LINK_TTL_HOURS=24
